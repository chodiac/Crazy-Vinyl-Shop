# ===========================================================================
# Crazy Vinyl Shop — environment
#
# Copy to .env for local use. NEVER commit .env, and never put the service-role
# key anywhere the browser can read it (that means: not in admin/config.js, not
# in any file under assets/ or admin/).
#
# The two public values — project URL and anon key — belong in admin/config.js
# instead, and are safe there: row level security, not secrecy, is what guards
# the data.
# ===========================================================================

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Project Settings → API → service_role (secret)
# Used by tools/content.py (locally) and by GitHub Actions (as a repo secret).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# GitHub Actions secrets (Settings → Secrets and variables → Actions)
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#
# Supabase Edge Function secrets (Edge Functions → Secrets)
#   GITHUB_TOKEN   fine-grained PAT with Contents: read and write on the repo
#   GITHUB_REPO    owner/repository, e.g. davidtucakovic/Crazy-Vinyl-Shop
# ---------------------------------------------------------------------------
